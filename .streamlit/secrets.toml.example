# For Streamlit Community Cloud:
# App settings → Secrets → paste the keys you need.
#
# Locally you can copy this to .streamlit/secrets.toml (gitignored).

XAI_API_KEY = "xai-your-new-key"

# Per-browser free-explore caps (LinkedIn launch protection).
# Analyse burns xAI credits; downloads are local but capped for fairness.
MAX_ANALYSES_PER_VISITOR = "2"
MAX_RESUME_DOWNLOADS = "2"
